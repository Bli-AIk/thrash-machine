#!/usr/bin/env bash
# tools/just — run the mod's justfile recipes without needing a standalone
# `just` install. This is the interface the build workflow uses so a pristine
# Windows machine works out of the box:
#
#   $JUST (explicit binary)                      — always wins
#   Windows: the debug-tools GUI sidecar
#       <mod-root>/.tools/gui/kristal-run-windows-{x64,arm64}.exe
#       in its `just-task` mode (just 1.58.0 is compiled into kristal-run).
#       If the sidecar is missing it is downloaded on demand (SHA256-verified,
#       same scheme as libraries/kristal-debug-tools/gui.cmd).
#   `just` on PATH                               — normal on Linux/CI
#   otherwise: clear error with install guidance.
#
# The wrapper cd's into the mod root first, so recipes behave exactly like
# running `just build` from the mod root (justfile_directory = invocation
# directory = mod root). Any extra arguments are passed through to just.
#
# Override the sidecar with $KRISTAL_RUN. Requires Git Bash on Windows (the
# build scripts need bash/tar/curl anyway).
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
MOD_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
JUSTFILE="$MOD_ROOT/justfile"

die() {
    printf 'tools/just: %s\n' "$*" >&2
    exit 1
}

is_windows_host() {
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) return 0 ;;
        *) return 1 ;;
    esac
}

host_arch() {
    case "$(uname -m)" in
        x86_64|amd64) printf 'x64\n' ;;
        aarch64|arm64) printf 'arm64\n' ;;
        *) return 1 ;;
    esac
}

# Resolve the GUI sidecar (kristal-run), downloading it on demand if absent.
# Always returns 0 or dies with a clear message.
resolve_kristal_run() {
    local bin="${KRISTAL_RUN:-}" arch dir exe
    if [ -n "$bin" ]; then
        command -v "$bin" >/dev/null 2>&1 && { command -v "$bin"; return 0; }
        [ -f "$bin" ] && { printf '%s\n' "$bin"; return 0; }
        die "KRISTAL_RUN points to a missing binary: $bin"
    fi
    arch="$(host_arch)" || die "unsupported host architecture: $(uname -m)"
    dir="$MOD_ROOT/.tools/gui"
    exe="$dir/kristal-run-windows-$arch.exe"
    [ -f "$exe" ] || download_sidecar "$dir" "$arch" "$exe"
    printf '%s\n' "$exe"
}

# Download the sidecar + checksums from the latest GUI release and verify the
# SHA256, mirroring gui.cmd's scheme (same files, same base URL).
download_sidecar() {
    local dir="$1" arch="$2" exe="$3"
    local base="https://github.com/Bli-AIk/kristal-debug-tools-gui/releases/latest/download/"
    command -v curl >/dev/null 2>&1 || die "curl is required to download the embedded just (kristal-run)"
    command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required to verify the downloaded sidecar"
    mkdir -p "$dir"
    printf 'tools/just: downloading embedded just (kristal-run windows-%s, latest release)…\n' "$arch" >&2
    curl --fail --location --output "$exe" "$base/kristal-run-windows-$arch.exe" \
        || die "download of kristal-run-windows-$arch.exe failed"
    curl --fail --location --output "$dir/checksums-windows-$arch.txt" "$base/checksums-windows-$arch.txt" \
        || die "download of checksums-windows-$arch.txt failed"
    local actual
    actual="$(sha256sum "$exe" | awk '{print $1}')"
    if ! grep -qi "$actual" "$dir/checksums-windows-$arch.txt"; then
        rm -f "$exe"
        die "checksum mismatch for kristal-run-windows-$arch.exe; check your network or delete .tools/gui and retry"
    fi
    printf 'tools/just: sidecar ready: %s\n' "$exe" >&2
}

[ -f "$JUSTFILE" ] || die "no justfile at $JUSTFILE"

if [ -n "${JUST:-}" ] && command -v "$JUST" >/dev/null 2>&1; then
    cd "$MOD_ROOT"
    exec "$JUST" "$@"
fi

if is_windows_host; then
    # Prefer the GUI-embedded just (kristal-run) over a standalone install.
    kr="$(resolve_kristal_run)"
    cd "$MOD_ROOT"
    exec "$kr" just-task "$JUSTFILE" "$@"
fi

if command -v just >/dev/null 2>&1; then
    cd "$MOD_ROOT"
    exec just "$@"
fi

die "no just found; install it (https://just.systems) or run this from a Git Bash that can reach the debug-tools GUI"
