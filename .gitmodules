[submodule "libraries/kristal-object-selector-plus"]
	path = libraries/kristal-object-selector-plus
	url = https://github.com/Bli-AIk/kristal-object-selector-plus.git
[submodule "libraries/kristal-i18n"]
	path = libraries/kristal-i18n
	url = https://github.com/Bli-AIk/kristal-i18n.git
[submodule "libraries/fumos"]
	path = libraries/fumos
	url = https://github.com/Bli-AIk/fumos.git
[submodule ".emacs"]
	path = .emacs
	url = https://github.com/Bli-AIk/kristal-emacs-config.git
